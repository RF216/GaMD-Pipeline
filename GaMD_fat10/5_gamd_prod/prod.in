GaMD production simulation (post-preparation)
 &cntrl
    imin=0,        ! No minimization
    irest=1,       ! Restarting from previous run (equilibration/prep stage)
    ntx=5,         ! Read coordinates AND velocities from restart file
    ! Temperature control
    ntt=3,         ! Langevin dynamics
    gamma_ln=2.0,  ! Friction coefficient (ps^-1) - matched to cMD
    temp0=310.0,   ! Target temperature
    ig=-1,         ! random seed
    ! Potential energy control
    cut=10.0,      ! nonbonded cutoff, in Angstroms - matched to cMD
    ! MD settings
    nstlim=5000000, ! 20 ns at dt=0.004 ps (20/0.000004)
    dt=0.004,      ! time step (ps) - matched to cMD (HMR)
    ! SHAKE
    ntc=2,         ! Constrain bonds containing hydrogen
    ntf=2,         ! Do not calculate forces of bonds containing hydrogen
    ntb=2,         ! periodic boundary, constant pressure
    tol=0.000001
    ! Control how often information is printed
    ntpr=25000,    ! matched to cMD
    ntwx=2500,     ! matched to cMD
    ntwr=250000,   ! matched to cMD
!   ntwv=-1,       ! Uncomment to also print velocities to trajectory
!   ntwf=-1,       ! Uncomment to also print forces to trajectory
    ntxo=2,        ! Write NetCDF format
    ioutfm=1,      ! Write NetCDF format (always do this!)
    ! Wrap coordinates when printing them to the same unit cell
    iwrap=1,
    ntwprt=2642,   ! matched to cMD
    ntr=0,         ! matched to cMD (no restraints)
    ! Constant pressure control
    barostat=2,    ! Monte Carlo barostat
    ntp=1,         ! isotropic
    pres0=1.0,     ! Target external pressure, in bar
    ! GaMD parameters - production: boost is now fixed, no more prep/update
    igamd=3, iE=1, irest_gamd=1,   ! irest_gamd=1: read boost params (Vmax/Vmin/Vavg/sigma etc.) from gamd-restart.dat
    ntcmdprep=0,   ! No cMD prep (already done)
    ntcmd=0,       ! No cMD statistics collection (already done)
    ntebprep=0,    ! No equilibration prep (already done)
    nteb=0,        ! No GaMD equilibration (already done)
    ntave=100000,  ! 400 ps averaging window (kept for reporting consistency)
    sigma0P=6.0, sigma0D=6.0,
 /
