#!/bin/bash
#PBS -N FAT10-prod
#PBS -o prod.out
#PBS -e prod.err
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1
#PBS -l walltime=15:00:00

cd $PBS_O_WORKDIR

module load Amber

# cMD run for 50ns
pmemd.cuda -O -i prod.in -p ../1_prepare_struct/fat10hmr.prmtop -c ../2_system_prep/fat10hmr.rst7 -o fat10.out -x fat10.nc -r fat10.rst7 -inf fat10.mdinfo
